{
  "name": "tabby-copilot",
  "version": "0.0.4",
  "description": "Per-tab AI copilot panel for Tabby: a Pi-style terminal agent that reads the screen, runs commands with approval, and reads files inside a per-tab whitelist.",
  "keywords": [
    "tabby-plugin",
    "tabby",
    "terminal",
    "ai",
    "agent",
    "copilot",
    "deepseek"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "webpack --progress --color",
    "watch": "TABBY_DEV=1 webpack --progress --color --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "preview": "tsx preview/server.ts"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dadadaguai/tabby-copilot.git"
  },
  "devDependencies": {
    "@angular/animations": "^15.2.10",
    "@angular/common": "^15.2.10",
    "@angular/compiler": "^15.2.10",
    "@angular/compiler-cli": "^15.2.10",
    "@angular/core": "^15.2.10",
    "@angular/forms": "^15.2.10",
    "@angular/platform-browser": "^15.2.10",
    "@babel/core": "^7.24.0",
    "@ngtools/webpack": "^15.2.10",
    "@tabby-gang/to-string-loader": "^1.1.7-beta.2",
    "@types/node": "^20.11.0",
    "@types/dompurify": "^3.0.5",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "dompurify": "^3.1.0",
    "marked": "^12.0.0",
    "sass": "^1.71.0",
    "sass-loader": "^14.1.0",
    "source-map-loader": "^5.0.0",
    "style-loader": "^3.3.4",
    "tabby-core": "npm:tabby-core@*",
    "tabby-settings": "npm:tabby-settings@*",
    "tabby-terminal": "npm:tabby-terminal@*",
    "tsx": "^4.23.13",
    "typescript": "~4.9.5",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "peerDependencies": {
    "@angular/common": "^15",
    "@angular/core": "^15",
    "@angular/forms": "^15",
    "@angular/platform-browser": "^15",
    "rxjs": "^7",
    "tabby-core": "*",
    "tabby-settings": "*",
    "tabby-terminal": "*"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/forms": {
      "optional": true
    },
    "@angular/platform-browser": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "tabby-core": {
      "optional": true
    },
    "tabby-settings": {
      "optional": true
    },
    "tabby-terminal": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
